CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# USB-OTG und USB-Serial-JTAG teilen sich den internen PHY an GPIO19/20.
# Sobald TinyUSB laeuft, ist die Konsole ueber USB weg - sie geht deshalb
# auf UART0 (TX GPIO43, RX GPIO44) und braucht einen seriellen Adapter.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Stereo raus, kein Mikrofon rein.
CONFIG_UAC_SPEAKER_CHANNEL_NUM=2
CONFIG_UAC_MIC_CHANNEL_NUM=0
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_UAC_BIT_RESOLUTION_16=y
CONFIG_UAC_TUSB_PRODUCT="ESP Speaker"
